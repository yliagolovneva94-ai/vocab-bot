# Copy to .env and fill in. Never commit the real .env.

# Telegram bot token from @BotFather
BOT_TOKEN=

# Anthropic API key from console.anthropic.com
ANTHROPIC_API_KEY=

# Optional. Path to the SQLite file. Point this at a mounted volume in
# production, otherwise the vocabulary is lost on every redeploy.
DB_PATH=vocab.db
